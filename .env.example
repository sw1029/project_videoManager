# 어댑터 선택 키 (frame/config/registry.py 의 등록 키와 일치해야 함)
FRAME_STRUCTURER=rule_based        # rule_based | fake | llm (stub)
FRAME_GENERATOR=fake               # fake | diffusers (stub) | external_api (stub)
FRAME_ASSEMBLER=fake               # fake | ffmpeg (stub)
FRAME_TRACKER=fake                 # fake | opencv (stub)
FRAME_CHECKERS=fake_requirement,fake_consistency,fake_preservation
FRAME_ARTIFACT_STORE=local_fs      # memory | local_fs
FRAME_ARTIFACT_DIR=./artifacts
FRAME_PERSISTENCE=sqlalchemy       # memory | sqlalchemy
FRAME_DB_URL=mysql+pymysql://frame:frame@localhost:3306/frame
FRAME_JOBS=thread                  # inline | thread | recording
FRAME_GENERATOR_RETRIES=1
FRAME_GENERATOR_CACHE=true

# --- LLM (요구사항 구조화) ---
# FRAME_STRUCTURER=llm 일 때 사용. API 키는 환경 변수 OPENAI_API_KEY 또는 키 파일로만 전달한다 (저장소에 넣지 말 것)
FRAME_LLM_PROVIDER=fake            # fake | openai (OpenAI 호환 로컬 서버도 openai)
FRAME_LLM_MODEL=gpt-4.1-mini
FRAME_LLM_KEY_FILE=F:/key.txt      # 또는 OPENAI_API_KEY=sk-...
FRAME_LLM_BASE_URL=                # 로컬 3090: http://localhost:8001/v1 (vLLM --port 8001)
FRAME_LLM_TIMEOUT_S=60
FRAME_LLM_TEMPERATURE=0            # none 이면 보내지 않음 (추론 모델은 자동 생략)
FRAME_LLM_STRICT_SCHEMA=true       # 로컬 서버가 strict json_schema 를 지원하지 않으면 false
FRAME_LLM_MAX_ATTEMPTS=3           # 검증 실패 시 자기수정 재시도 횟수
