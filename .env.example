# 어댑터 선택 키 (frame/config/registry.py 의 등록 키와 일치해야 함)
FRAME_STRUCTURER=rule_based        # rule_based(DSL 입력) | llm(자연어 입력) | fake
FRAME_GENERATOR=fake               # fake | external_api (OpenRouter, 아래 '영상 생성 API') | diffusers (stub)
FRAME_ASSEMBLER=fake               # fake | ffmpeg (장면 클립을 이어 최종 mp4. external_api 와 함께, ffmpeg 필요)
FRAME_TRACKER=fake                 # fake | opencv (stub)
FRAME_CHECKERS=fake_requirement,fake_consistency,fake_preservation
# 실제 검수기 (ffmpeg 필요): vlm_consistency(표본 프레임을 VLM 이 판정, 아래 FRAME_VLM_MODEL) · ssim_preservation(부모 클립 대비 SSIM)
#   vlm_requirement(요구조건별로 VLM 이 프레임을 판정, 지표 2) · vlm_preservation(다시 만든 장면에서 유지 요소·비대상 요소를 VLM 이 부모와 비교)
# 예) FRAME_CHECKERS=vlm_requirement,vlm_consistency,vlm_preservation
FRAME_CONSISTENCY_FRAMES=3         # 일관성 검수가 장면마다 뽑는 표본 프레임 수
FRAME_CONSISTENCY_THRESHOLD=0.9    # 고정 속성 유지율 목표 (지표 3)
FRAME_PRESERVATION_THRESHOLD=0.9   # 다시 만든 장면의 부모 클립 대비 SSIM 하한 (비대상 변경률 10% 이하)
FRAME_REQUIREMENT_FRAMES=3         # 요구 반영 검수가 장면마다 뽑는 표본 프레임 수
FRAME_REQUIREMENT_THRESHOLD=0.5    # 고정 속성·장면 조건: 판정된 프레임 가운데 지킨 비율의 하한 (행동·관계는 한 프레임이면 된다)
FRAME_PRESERVATION_FRAMES=2        # 유지 요소 검수가 다시 만든 장면마다 부모·자식에서 뽑는 프레임 쌍의 수
FRAME_ARTIFACT_STORE=local_fs      # memory | local_fs (local_fs 는 영상 Range 응답 지원)
FRAME_ARTIFACT_DIR=./artifacts
FRAME_PERSISTENCE=sqlalchemy       # memory | sqlalchemy
FRAME_DB_URL=mysql+pymysql://frame:frame@localhost:3306/frame   # 로컬 시연: sqlite+pysqlite:///./frame.db
FRAME_JOBS=thread                  # inline | thread | recording (실제 모델은 thread 이상 + 화면 폴링)
FRAME_GENERATOR_TIMEOUT_S=900      # 장면 하나 생성의 범용 시간 제한(초). 0·빈 값이면 끔. FRAME_VIDEO_TIMEOUT_S + 300 이상 (ADR-0012)
FRAME_GENERATOR_RETRIES=1
FRAME_GENERATOR_CACHE=true         # 기본 true. 같은 조건·생성기 설정의 장면은 한 번만 생성 (산출물 저장소 cache/clips 에 영속)
FRAME_WORKER_LEASE_S=1800          # 재시작 복구: 실행 중 PROCESSING 이 이 시간을 넘기면 워커 유실 (버전 하나의 최대 처리 시간보다 길게)
FRAME_WORKER_MAX_ATTEMPTS=3        # 워커 유실 뒤 재시도를 포함한 실행 상한. 넘으면 FAILED(WORKER_LOST)
FRAME_RECOVERY_INTERVAL_S=60       # 리스 검사 주기 (0 이면 기동 때만 복구)

# --- LLM (요구사항 구조화) ---
# FRAME_STRUCTURER=llm 이면 기본으로 OpenAI 를 쓴다. 키·패키지가 없으면 서버 기동이 실패한다.
# API 키는 환경 변수 OPENAI_API_KEY 또는 키 파일로 전달한다 (저장소에 넣지 말 것)
FRAME_LLM_PROVIDER=openai          # openai(기본, OpenAI 호환 로컬 서버 포함) | fake(테스트용)
FRAME_LLM_MODEL=gpt-4.1-mini
FRAME_LLM_KEY_FILE=F:/key.txt      # 또는 OPENAI_API_KEY=sk-...
FRAME_LLM_BASE_URL=                # 로컬 3090: http://localhost:8001/v1 (vLLM --port 8001)
FRAME_LLM_TIMEOUT_S=60
FRAME_LLM_TEMPERATURE=0            # none 이면 보내지 않음 (추론 모델은 자동 생략)
FRAME_LLM_STRICT_SCHEMA=true       # 로컬 서버가 strict json_schema 를 지원하지 않으면 false
FRAME_LLM_MAX_ATTEMPTS=3           # 검증 실패 시 자기수정 재시도 횟수
FRAME_LLM_RUNTIME_KEY=false        # true: 키 없이 기동하고 화면에서 키 입력 (메모리에만, 재시작 시 사라짐). 시연 런처가 켠다
FRAME_LLM_RUNTIME_KEY_ALLOW_REMOTE=false  # true 면 다른 기기에서도 키 입력 허용. 인증이 없으므로 켜지 말 것

# --- 장면 사이 객체 일관성 (ADR-0015) ---
# 켜면 객체가 처음 나온 클립에서 정체성 기준 이미지를 뽑아 버전에 저장하고, 그 객체가 나오는 다른 장면 생성에 참조로 넘긴다.
FRAME_IDENTITY=off                 # off | vlm_crop(VLM 으로 객체를 잘라 냄) | frame(클립 가운데 프레임 전체) | fake
FRAME_IDENTITY_KINDS=PERSON,ANIMAL,PROP,OTHER   # 기준 이미지를 두는 객체 종류 (우선순위 순)
FRAME_IDENTITY_MAX_REFERENCES=3    # 장면 요청 하나에 넘기는 기준 이미지 상한
FRAME_IDENTITY_VERIFY_ATTRIBUTES=true   # vlm_crop: 요구한 고정 속성(색 등)과 분명히 다르게 나온 객체는 기준으로 쓰지 않는다. false 면 위치·외형만 묻는다
FRAME_VLM_MODEL=                   # 이미지를 읽는 모델 (vlm_crop · vlm_consistency). 비우면 FRAME_LLM_MODEL. 키·주소는 FRAME_LLM_* 와 같다

# --- 수정 요청 (ADR-0017, 0019) ---
# 글로 쓴 변경 요청을 구조화하는 해석기 (POST /versions/{id}/revision-plans 의 request_text)
FRAME_CHANGE_INTERPRETER=auto      # auto(구조화기를 따름: llm 이면 llm, 아니면 rule_based) | rule_based('cup.color = teal' 형식) | llm(자연어)

# --- 프론트 연동·배포 ---
FRAME_CORS_ORIGINS=                # 다른 출처에서 띄운 화면 허용 (예: http://localhost:5173). 비우면 꺼짐
FRAME_FRONTEND_DIST=               # 빌드된 화면 폴더 (예: ./frontend/dist). 지정하면 같은 출처 "/" 에서 서빙
FRAME_RATE_LIMIT_PER_MINUTE=0      # 공개 데모: IP 별 변경 요청(POST·PUT) 수 제한 (0 이면 꺼짐)
FRAME_REFERENCE_IMAGE_MAX_BYTES=   # 참조 이미지 업로드 크기 상한(바이트). 비우면 10 MiB. PNG·JPEG·WebP 만 받는다

# --- 영상 생성 API (FRAME_GENERATOR=external_api, OpenRouter /api/v1/videos) ---
# 키나 ffmpeg 가 없으면 서버 기동이 실패한다. 키는 환경 변수 OPENROUTER_API_KEY 또는 키 파일로 전달한다 (저장소에 넣지 말 것)
# ffmpeg: pip install -e ".[video]" (imageio-ffmpeg) 또는 PATH 의 ffmpeg 또는 FRAME_VIDEO_FFMPEG
FRAME_VIDEO_MODEL=alibaba/wan-3.0  # https://openrouter.ai/api/v1/videos/models 의 id (예: google/gemini-omni-1.2-flash)
FRAME_VIDEO_RESOLUTION=720p        # 시험은 480p (Wan 3.0: 480p $0.05/s · 720p $0.10/s · 1080p $0.20/s)
FRAME_VIDEO_ASPECT_RATIO=9:16
FRAME_VIDEO_FPS=30                 # 정규화한 클립 fps. Wan 3.0 원본이 30fps, 100 ms 단위 장면 길이가 정확히 맞음
FRAME_VIDEO_KEY_FILE=              # sk-or-... 가 든 파일 (예: ./.demo/openrouter.key). 또는 OPENROUTER_API_KEY=sk-or-...
FRAME_VIDEO_BASE_URL=https://openrouter.ai/api/v1
FRAME_VIDEO_TIMEOUT_S=600          # 제출부터 완료까지. 넘으면 GENERATION_TIMEOUT (작업은 계속돼 과금될 수 있음)
FRAME_VIDEO_POLL_INTERVAL_S=20
FRAME_VIDEO_FFMPEG=                # ffmpeg 실행 파일 경로 (비우면 PATH -> imageio-ffmpeg 순서로 찾음)
# 수정 버전에서 다시 만드는 장면을 부모 클립 편집으로 만든다 (ADR-0016). 편집 요청이 거절되면 새로 생성한다
# video_reference 는 부모 클립을 만든 OpenRouter 작업의 저장본 주소를 넘긴다 (생성 뒤 약 24시간 안에만 된다)
# previous_job 은 2026-11 기준 받는 모델을 찾지 못했다 (Wan 3.0 은 거절)
FRAME_VIDEO_EDIT_MODE=off          # off | previous_job(부모 작업을 previous_job_id 로 이어서) | video_reference(부모 클립을 영상 참조로)
FRAME_VIDEO_EDIT_MODEL=            # video_reference 의 편집 모델 (예: black-forest-labs/flux-video-edit). 비우면 FRAME_VIDEO_MODEL
# video_reference: 부모 작업의 저장본 주소가 상태 응답에 없을 때 다시 묻는 시간(초). 넘기면 새로 생성한다 (0 이면 한 번만 묻는다).
# 방금 끝난 작업은 주소가 몇 분 늦게 나온다. 늘리면 생성 직후의 수정도 편집으로 만들지만 그만큼 기다린다
FRAME_VIDEO_EDIT_PARENT_WAIT_S=10
